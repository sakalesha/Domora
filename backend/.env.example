# Application Environment ('development', 'test', 'production')
APP_ENV=development

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./domora.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domora

# Secret Key (minimum 32 characters in production)
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-12345

# Auth Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ACCESS_COOKIE_NAME=domora_access

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed Privileged Accounts
SEED_OPS_USERNAME=ops_admin
SEED_OPS_PASSWORD=DomoraOpsDemo2026!
SEED_OPS_FULL_NAME=Domora Operations Team
SEED_OPS_PHONE=+919876543210

