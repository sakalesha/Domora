{
  "name": "domora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build:frontend && tsx server.ts",
    "build": "npm run build:frontend && ./frontend/node_modules/.bin/tsc --noEmit -p tsconfig.server.json",
    "build:frontend": "NODE_ENV=production npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "start": "tsx server.ts",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.23.15"
  }
}
